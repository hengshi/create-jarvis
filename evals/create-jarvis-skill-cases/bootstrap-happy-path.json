{
  "id": "bootstrap-happy-path",
  "title": "Runtime-driven pilot-ready bootstrap",
  "mode": "happy-path",
  "prompt": "Use create-jarvis-skill to bootstrap a JARVIS instance for a fictional B2B analytics company. Runtime caller: jarvis-box. JARVIS_TARGET_HOME and JARVIS_HOME point to the same output directory. Company name: Acme Metrics. First workflow: bug intake -> triage -> fix -> release note. Git host and projects are provided. Owners are provided. Writeback policy is local-only. Generate the minimum pilot-ready instance and runtime result files.",
  "expected": {
    "status": "completed",
    "bootstrap_result_required_fields": [
      "schema_version",
      "status",
      "result_code",
      "summary",
      "paths.jarvis_home",
      "paths.jarvis_target_home",
      "paths.entry_skill",
      "method_repo.url",
      "created_files",
      "updated_files",
      "preserved_files",
      "unresolved_questions",
      "blockers",
      "writeback_policy",
      "next_action",
      "generated_at"
    ],
    "bootstrap_state_required_fields": [
      "schema_version",
      "phase",
      "status",
      "paths.jarvis_home",
      "paths.jarvis_target_home",
      "paths.entry_skill",
      "inputs",
      "confirmed_answers",
      "unresolved_questions",
      "generated_files",
      "scaffold_owned_files",
      "method_repo.url",
      "writeback_policy",
      "noninteractive",
      "updated_at"
    ],
    "required_files": [
      "SKILL.md",
      "README.md",
      "MAINTENANCE.md",
      "bootstrap-state.json",
      "bootstrap-result.json"
    ],
    "required_patterns": [
      "pilot-ready|shadow pilot",
      "JARVIS_HOME",
      "bootstrap-result.json",
      "local-only"
    ],
    "forbidden_patterns": [
      "\\.hengshi",
      "gitlab\\.hengshi\\.org",
      "Hengshi internal"
    ]
  }
}
