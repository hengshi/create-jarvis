FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION=22.23.1

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    curl \
    git \
    gzip \
    jq \
    openssh-client \
    python3 \
    tar \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  arch="$(uname -m)"; \
  case "$arch" in \
    aarch64|arm64) node_arch="arm64" ;; \
    x86_64|amd64) node_arch="x64" ;; \
    *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
  esac; \
  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz; \
  tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
  rm -f /tmp/node.tar.xz; \
  node --version; \
  npm --version

RUN npm install -g @anthropic-ai/claude-code \
  && claude --version

# Test-root installs skip service mutation; this stub satisfies the Ubuntu
# host preflight without claiming that systemd is active in the container.
RUN printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > /usr/local/bin/systemctl \
  && chmod 0755 /usr/local/bin/systemctl

COPY run-replay-in-container.sh /usr/local/bin/create-jarvis-replay
RUN chmod 0755 /usr/local/bin/create-jarvis-replay
