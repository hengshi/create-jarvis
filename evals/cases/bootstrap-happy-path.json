{
  "id": "bootstrap-happy-path",
  "title": "Agent-native company Jarvis bootstrap",
  "mode": "happy-path",
  "prompt": "You are an authenticated runtime agent in a prepared container. Use create-jarvis-skill directly; do not invoke or emulate a bootstrap form CLI. The customer only gives the company name Acme Metrics and authorized Git project URLs. Probe the writable workspace and sources, discover and propose the first workflow from evidence, use local-only until remote approval, and coordinate scan lanes yourself. Generate the customer company Jarvis repo and runtime state/result files. Ask only for irreducible identity/access/writeback decisions, and do not report machine checks or scaffold creation as completion.",
  "expected": {
    "status": "completed",
    "bootstrap_result_required_fields": [
      "schema_version",
      "status",
      "result_code",
      "summary",
      "paths.jarvis_home",
      "paths.jarvis_target_home",
      "paths.entry_skill",
      "method_repo.url",
      "created_files",
      "updated_files",
      "preserved_files",
      "unresolved_questions",
      "blockers",
      "writeback_policy",
      "next_action",
      "generated_at"
    ],
    "bootstrap_state_required_fields": [
      "schema_version",
      "phase",
      "status",
      "paths.jarvis_home",
      "paths.jarvis_target_home",
      "paths.entry_skill",
      "inputs",
      "confirmed_answers",
      "unresolved_questions",
      "generated_files",
      "scaffold_owned_files",
      "method_repo.url",
      "writeback_policy",
      "noninteractive",
      "updated_at"
    ],
    "required_files": [
      "README.md",
      "MAINTENANCE.md",
      "jarvis.toml",
      "skills/acme-metrics-jarvis/SKILL.md",
      "references/jarvis-first-routing.md",
      "cross-cutting/module-interactions.md",
      "bootstrap-state.json",
      "bootstrap-result.json"
    ],
    "required_patterns": [
      "Company Jarvis|shadow pilot",
      "JARVIS_HOME",
      "bootstrap-result.json",
      "local-only"
    ],
    "forbidden_patterns": [
      "reference-company-private-host",
      "reference-company-internal",
      "reference-company-runtime-root",
      "top-level repos/",
      "top-level workflows/"
    ]
  }
}
